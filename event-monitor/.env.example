# Copy to .env on the VPS. Never commit real credentials.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Generic JSON API endpoint to poll
SOURCE_URL=https://example.com/api/events
SOURCE_BEARER_TOKEN=

# Polling and condition
POLL_INTERVAL_SECONDS=10
REQUEST_TIMEOUT_SECONDS=15
EVENT_VALUE_FIELD=value
EVENT_VALUE_MINIMUM=1000

# Local persistence
DATABASE_PATH=data/events.sqlite3
LOG_PATH=logs/monitor.log
