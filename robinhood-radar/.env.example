RPC_URL=https://rpc.mainnet.chain.robinhood.com
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DATABASE_PATH=./data/radar.db
POLL_INTERVAL_SECONDS=3
BLOCK_BATCH_SIZE=250
CONFIRMATIONS=1
OBSERVATION_MINUTES=30
# Comma-separated checksummed or lowercase addresses. At least one factory is required.
UNISWAP_V2_FACTORIES=
UNISWAP_V3_FACTORIES=
UNISWAP_V4_POOL_MANAGERS=
LOG_LEVEL=INFO
# Optional and potentially unsupported/expensive. Standard operation does not require traces.
TRACE_ENABLED=false
CONTRACT_MONITOR_ENABLED=true
MAX_RPC_CONCURRENCY=4
MAX_TRACE_CONCURRENCY=1
MAX_ACTIVITY_CLUSTERS=10
ACTIVITY_SAMPLE_INTERVAL=60
EXTERNAL_PROVIDER_TIMEOUT=10
