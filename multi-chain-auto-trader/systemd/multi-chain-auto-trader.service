[Unit]
Description=Independent Multi-Chain Auto Trader (fail-closed until adapters reviewed)
After=network-online.target
Wants=network-online.target
[Service]
Type=simple
User=trader
Group=trader
WorkingDirectory=/opt/multi-chain-auto-trader
EnvironmentFile=/etc/multi-chain-auto-trader.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/multi-chain-auto-trader/.venv/bin/python -m app.main
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/multi-chain-auto-trader /var/log/multi-chain-auto-trader
UMask=0077
[Install]
WantedBy=multi-user.target
