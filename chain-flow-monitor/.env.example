# 本监控专用配置：/etc/chain-flow-monitor.env
# 必须使用新建机器人的 Token，不要复制旧机器人 Token。
# 由 systemd EnvironmentFile 读取。不要把真实密钥发到聊天里。
FLOW_TELEGRAM_BOT_TOKEN=
FLOW_TELEGRAM_CHAT_ID=
# 可选。没有授权 Key 时仍可查看免费指标，但不能生成跨链净流入/出。
DEFILLAMA_API_KEY=
# 联调核实链级 depositUSD 的视角后填写 inflow 或 outflow；不要猜。
# 留空时保存桥原始日数据，但不生成方向性排名。
BRIDGE_DEPOSIT_DIRECTION=
