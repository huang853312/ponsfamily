[Unit]
Description=X follow monitor via xAPI.to
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/ponsfamily/x-follow-monitor
EnvironmentFile=-/etc/robinhood-radar.env
EnvironmentFile=-/opt/robinhood-radar/.env
EnvironmentFile=-/home/ubuntu/ponsfamily/x-follow-monitor/.env
Environment=PYTHONUNBUFFERED=1
Environment=X_FOLLOW_INTERVAL=1800
ExecStart=/usr/bin/python3 /home/ubuntu/ponsfamily/x-follow-monitor/app.py
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
