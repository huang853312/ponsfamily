[Unit]
Description=X follow monitor via xAPI.to
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/ponsfamily/x-follow-monitor
EnvironmentFile=/home/ubuntu/ponsfamily/x-follow-monitor/.env
Environment=PYTHONUNBUFFERED=1
Environment=X_FOLLOW_INTERVAL=1800
ExecStartPre=/usr/bin/python3 -m py_compile /home/ubuntu/ponsfamily/x-follow-monitor/app.py
ExecStart=/usr/bin/python3 /home/ubuntu/ponsfamily/x-follow-monitor/app.py
Restart=on-failure
RestartSec=10
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
