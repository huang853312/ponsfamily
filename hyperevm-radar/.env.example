TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Each request is bounded, and an entire Family enrichment also has a deadline.
IDENTITY_REQUEST_TIMEOUT=6
IDENTITY_TOTAL_TIMEOUT=35

# Optional replaceable JSON search API. Expected result items use url/link,
# title and snippet/description keys. Without it, the provider chain uses its
# public HTML fallback and safely records NO_DATA when that source is unavailable.
HYPEREVM_SEARCH_API_URL=
HYPEREVM_SEARCH_API_KEY=
