# Copy to .env on the VPS. Never commit real secrets.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# JSON object: chain name -> HTTPS/WSS-capable JSON-RPC HTTP endpoint.
# Example: {"hyperevm":"https://YOUR_RPC","base":"https://YOUR_RPC"}
RPC_URLS={}

# Poll cadence in seconds. Requested default: 3.
POLL_INTERVAL=3

# Confirm blocks before querying logs. Can be overridden per chain in CHAIN_SETTINGS.
DEFAULT_CONFIRMATIONS=2

# Optional JSON object, e.g. {"base":{"confirmations":2,"start_block":123}}
CHAIN_SETTINGS={}

# Event conditions are intentionally empty until explicitly configured.
# Example:
# {"base":{"addresses":["0x..."],"topics":["0xddf252ad..."]}}
EVENT_FILTERS={}

# Maximum block span per eth_getLogs request.
MAX_BLOCK_RANGE=100
LOG_LEVEL=INFO
