# 独立多链钱包雷达。只属于 /opt/wallet-radar，不读取现有 HyperEVM Radar 配置。
# Robinhood 使用官方 RPC；PublicNode 对历史 eth_getLogs 会把归档查询返回 403。
ROBINHOOD_RPC_URL=https://rpc.mainnet.chain.robinhood.com
HYPEREVM_RPC_URL=https://rpc.hyperliquid.xyz/evm
# BNB 官方公共 RPC 已关闭 eth_getLogs；Wallet Radar 使用 NodeReal 官方公开共享 Key 读取历史日志。
BNB_RPC_URL=https://bsc-mainnet.nodereal.io/v1/f8728a3265504b998a2f09c83493d76a
REQUEST_TIMEOUT=30
RPC_BATCH_SIZE=50
BNB_LOG_CHUNK=500

# 可选：中文电报报告。安装器会尝试从现有 Robinhood Radar 环境中只复制这两个值；不会修改原文件。
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# 可选：自建钱包标签库
WALLET_LABELS_FILE=/opt/wallet-radar/labels.json
